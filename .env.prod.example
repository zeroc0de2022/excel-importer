# Production environment. deploy/setup: copy to .env on the server and fill in every CHANGE_ME.
APP_NAME="Excel Importer"
APP_ENV=production
APP_KEY=CHANGE_ME_base64_key
APP_DEBUG=false
APP_URL=https://excel-import.movsar.dev

# The edge proxy that terminates TLS (comma-separated IPs)
TRUSTED_PROXIES=192.168.30.11

BASIC_AUTH_USER=demo
BASIC_AUTH_PASSWORD=CHANGE_ME

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=excel_importer
DB_USERNAME=excel
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=660
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

REVERB_APP_ID=excel-importer
REVERB_APP_KEY=CHANGE_ME
REVERB_APP_SECRET=CHANGE_ME
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Public demo limits
IMPORT_MAX_FILE_KB=10240
IMPORT_MAX_ROWS=200000
IMPORT_KEEP_DAYS=2
IMPORT_PRUNE_ROWS=true
